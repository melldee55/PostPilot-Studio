<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PostPilot Studio</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Segoe UI', system-ui, sans-serif;
      background: #0c0e13;
      color: #e2e4ed;
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
    }

    /* ── Top bar ─────────────────────────────────────────── */
    #topbar {
      display: flex;
      align-items: center;
      gap: 0;
      background: #10131c;
      border-bottom: 1px solid #272e44;
      padding: 0 20px;
      height: 48px;
      flex-shrink: 0;
    }

    #brand {
      font-size: 14px;
      font-weight: 700;
      color: #f59e0b;
      letter-spacing: 0.3px;
      margin-right: 28px;
      white-space: nowrap;
    }
    #brand span {
      color: #8b8fa8;
      font-weight: 400;
    }

    /* ── Tabs ───────────────────────────────────────────── */
    .tab {
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 0 18px;
      height: 48px;
      font-size: 13px;
      font-weight: 600;
      color: #6b7080;
      cursor: pointer;
      border-bottom: 2px solid transparent;
      transition: color 0.15s, border-color 0.15s;
      user-select: none;
      white-space: nowrap;
    }
    .tab:hover { color: #c0c4d4; }
    .tab.active {
      color: #f59e0b;
      border-bottom-color: #f59e0b;
    }

    /* ── iframe container ───────────────────────────────── */
    #frames {
      flex: 1;
      position: relative;
      overflow: hidden;
    }

    iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: none;
      display: none;
    }
    iframe.visible { display: block; }

    /* ── Loading overlay ────────────────────────────────── */
    .loader {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      background: #0c0e13;
      color: #6b7080;
      font-size: 13px;
      pointer-events: none;
      transition: opacity 0.3s;
    }
    .loader.hidden { opacity: 0; }
    .spinner {
      width: 32px; height: 32px;
      border: 3px solid #272e44;
      border-top-color: #f59e0b;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>

  <!-- Top bar -->
  <div id="topbar">
    <div id="brand">PostPilot Studio</div>

    <div class="tab active" id="tab-creator" onclick="switchTab('creator')">
      🎨 Post Creator
    </div>
    <div class="tab" id="tab-scheduler" onclick="switchTab('scheduler')">
      📅 Scheduler
    </div>
  </div>

  <!-- iframes -->
  <div id="frames">
    <!-- Loading overlay (hides once active frame loads) -->
    <div class="loader" id="loader">
      <div class="spinner"></div>
      <span>Loading…</span>
    </div>

    <iframe id="frame-creator"  src="PPPostCreator_v50b.html" class="visible" onload="onFrameLoad('creator')"></iframe>
    <iframe id="frame-scheduler" src="PostPilot.html"          onload="onFrameLoad('scheduler')"></iframe>
  </div>

  <script>
    const loaded = { creator: false, scheduler: false };

    function onFrameLoad(id) {
      loaded[id] = true;
      // Hide loader once the active frame is ready
      const activeId = document.querySelector('.tab.active').id.replace('tab-', '');
      if (id === activeId) {
        document.getElementById('loader').classList.add('hidden');
      }
    }

    function switchTab(id) {
      // Update tab styles
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.getElementById('tab-' + id).classList.add('active');

      // Show/hide frames
      document.querySelectorAll('iframe').forEach(f => f.classList.remove('visible'));
      document.getElementById('frame-' + id).classList.add('visible');

      // Show loader if this frame hasn't loaded yet
      if (!loaded[id]) {
        document.getElementById('loader').classList.remove('hidden');
      } else {
        document.getElementById('loader').classList.add('hidden');
      }
    }
  </script>

</body>
</html>
